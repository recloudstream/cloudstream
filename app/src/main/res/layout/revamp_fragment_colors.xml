<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cloneflix_canvas_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/cloneflix_spacing_3xl">

        <com.lagradost.cloudstream3.ui.revamp.components.CloneflixHeaderView
            android:id="@+id/colorsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:headerIcon="@drawable/cloneflix_ic_colors"
            app:headerSubtitle="33+ Tokens • Primary, Secondary, Greys, Transparent"
            app:headerTitle="Colors"
            app:showDivider="true" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/cloneflix_spacing_3xl" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvColorSections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
