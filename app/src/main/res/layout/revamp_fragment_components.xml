<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cloneflix_canvas_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/cloneflix_spacing_3xl">

        <com.lagradost.cloudstream3.ui.revamp.components.CloneflixHeaderView
            android:id="@+id/componentsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:headerIcon="@drawable/cloneflix_ic_about"
            app:headerSubtitle="Buttons • Cards • Inputs • Custom Views"
            app:headerTitle="Components"
            app:showDivider="true" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/cloneflix_spacing_3xl" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="BUTTON VARIANTS"
            android:textColor="@color/cloneflix_primary_red"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cloneflix_spacing_l"
            android:orientation="vertical">

            <com.lagradost.cloudstream3.ui.revamp.components.CloneflixButton
                android:id="@+id/btnDemoPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/cloneflix_spacing_m"
                app:cloneflixButtonSize="large"
                app:cloneflixButtonVariant="primary"
                app:cloneflixIcon="@drawable/cloneflix_ic_open_in_new"
                app:cloneflixText="Primary Action (Red)" />

            <com.lagradost.cloudstream3.ui.revamp.components.CloneflixButton
                android:id="@+id/btnDemoSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/cloneflix_spacing_m"
                app:cloneflixButtonSize="medium"
                app:cloneflixButtonVariant="secondary"
                app:cloneflixText="Secondary Action (White)" />

            <com.lagradost.cloudstream3.ui.revamp.components.CloneflixButton
                android:id="@+id/btnDemoOutline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/cloneflix_spacing_m"
                app:cloneflixButtonSize="medium"
                app:cloneflixButtonVariant="outline"
                app:cloneflixIcon="@drawable/cloneflix_ic_copy"
                app:cloneflixText="Outlined Action (Border)" />

            <com.lagradost.cloudstream3.ui.revamp.components.CloneflixButton
                android:id="@+id/btnDemoGhost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cloneflixButtonSize="small"
                app:cloneflixButtonVariant="ghost"
                app:cloneflixText="Ghost Action (Transparent)" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/cloneflix_spacing_3xl" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="INPUT FIELDS"
            android:textColor="@color/cloneflix_primary_red"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cloneflix_spacing_l"
            android:orientation="vertical">

            <com.lagradost.cloudstream3.ui.revamp.components.CloneflixInputField
                android:id="@+id/inputDemoEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email address or phone number"
                android:inputType="textEmailAddress" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/cloneflix_spacing_m" />

            <com.lagradost.cloudstream3.ui.revamp.components.CloneflixInputField
                android:id="@+id/inputDemoPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password"
                android:inputType="textPassword" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/cloneflix_spacing_3xl" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="CARD CONTAINERS &amp; ELEVATION"
            android:textColor="@color/cloneflix_primary_red"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cloneflix_spacing_l"
            android:orientation="vertical">

            <com.lagradost.cloudstream3.ui.revamp.components.CloneflixCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/cloneflix_spacing_m"
                app:cardElevationLevel="surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/cloneflix_spacing_l">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/netflix_sans"
                        android:text="Surface Container (#232323)"
                        android:textColor="@color/cloneflix_primary_white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/netflix_sans"
                        android:text="Standard content card with 16dp rounded corners and subtle border."
                        android:textColor="@color/cloneflix_grey_200"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.lagradost.cloudstream3.ui.revamp.components.CloneflixCardView>

            <com.lagradost.cloudstream3.ui.revamp.components.CloneflixCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevationLevel="elevated">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/cloneflix_spacing_l">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/netflix_sans"
                        android:text="Elevated Container (#181818)"
                        android:textColor="@color/cloneflix_primary_white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/netflix_sans"
                        android:text="Elevated surface card for modals, tooltips, and bottom sheets."
                        android:textColor="@color/cloneflix_grey_200"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.lagradost.cloudstream3.ui.revamp.components.CloneflixCardView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
