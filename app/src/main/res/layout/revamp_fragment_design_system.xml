<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cloneflix_canvas_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cloneflix_surface_elevated"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/cloneflix_spacing_3xl"
        android:paddingTop="@dimen/cloneflix_spacing_xl"
        android:paddingEnd="@dimen/cloneflix_spacing_3xl"
        android:paddingBottom="@dimen/cloneflix_spacing_m">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="CLONEFLIX"
            android:textColor="@color/cloneflix_primary_red"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cloneflix_spacing_m"
            android:fontFamily="@font/netflix_sans"
            android:text="Design System 2024"
            android:textColor="@color/cloneflix_primary_white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cloneflix_surface_elevated"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/cloneflix_primary_red"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/cloneflix_primary_white"
        app:tabTextAppearance="@style/TextAppearance.Cloneflix.Medium.SmallBody"
        app:tabTextColor="@color/cloneflix_grey_200" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cloneflix_border_subtle" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
