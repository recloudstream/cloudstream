<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/kick_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#1B1D21"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Stream Thumbnail with Viewers & Checkmark Badges -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="100dp">

            <ImageView
                android:id="@+id/kick_stream_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_github_logo" />

            <!-- Live Viewers Badge (e.g. 🟢 35.5K) -->
            <TextView
                android:id="@+id/kick_live_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:background="#A0000000"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="#53FC18"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="🟢 35.5K" />

            <!-- Selected Checkmark Badge (Green Checkmark) -->
            <ImageView
                android:id="@+id/kick_checkmark_badge"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:background="@drawable/player_button_tv"
                android:padding="4dp"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_baseline_check_24"
                app:tint="#53FC18"
                tools:visibility="visible" />

        </FrameLayout>

        <!-- Streamer Info (Avatar, Name, Title) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageView
                android:id="@+id/kick_avatar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/ic_github_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/kick_streamer_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="LoLzzZGaming" />

                <TextView
                    android:id="@+id/kick_stream_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/grayTextColor"
                    android:textSize="11sp"
                    tools:text="CEGC WATCHPARTY DAY 3" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
