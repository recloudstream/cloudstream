<?xml version="1.0" encoding="utf-8"?>
<!-- One hero card on the home page -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/home_hero_margin"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="?attr/primaryGrayBackground"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/home_scroll_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:src="@drawable/example_poster" />

        <View
            android:id="@+id/title_shadow_top"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_gravity="top"
            android:alpha="0.6"
            android:background="@drawable/background_shadow"
            android:rotation="180"
            android:visibility="visible" />

        <View
            android:id="@+id/title_shadow"
            android:layout_width="match_parent"
            android:layout_height="340dp"
            android:layout_gravity="bottom"
            android:background="@drawable/background_shadow" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="84dp"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <ImageView
                android:id="@+id/home_preview_logo"
                android:layout_width="260dp"
                android:layout_height="80dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@null"
                android:paddingBottom="10dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/home_scroll_preview_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center_horizontal"
                android:paddingBottom="8dp"
                android:shadowColor="#99000000"
                android:shadowRadius="8"
                android:textColor="?attr/white"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="The Perfect Run" />

            <TextView
                android:id="@+id/home_scroll_preview_tags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center_horizontal"
                android:textColor="?attr/grayTextColor"
                android:textSize="13sp"
                tools:text="Hello • World • Tags" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
