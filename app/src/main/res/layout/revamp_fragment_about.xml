<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cloneflix_canvas_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/cloneflix_spacing_3xl">

        <com.lagradost.cloudstream3.ui.revamp.components.CloneflixHeaderView
            android:id="@+id/aboutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:headerIcon="@drawable/cloneflix_ic_about"
            app:headerSubtitle="Cloneflix Design System 2024 (Website Version)"
            app:headerTitle="About"
            app:showDivider="true" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/cloneflix_spacing_3xl" />

        <include
            android:id="@+id/aboutCard"
            layout="@layout/revamp_view_about_card" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/cloneflix_spacing_3xl" />

        <com.lagradost.cloudstream3.ui.revamp.components.CloneflixCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevationLevel="elevated">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/cloneflix_spacing_3xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/netflix_sans"
                    android:text="Design System Specifications"
                    android:textColor="@color/cloneflix_primary_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cloneflix_spacing_s"
                    android:fontFamily="@font/netflix_sans"
                    android:text="• Typography: Netflix Sans &amp; Bebas Neue hierarchy across Regular, Medium, Bold\n• Color Tokens: 33+ precise Figma color tokens with RGB &amp; Hex mappings\n• Components: Material3 &amp; Compose-aligned Buttons, Cards, Inputs, Swatches, and Header bars\n• Form Factors: Optimized for Android Phone, Tablet, and Android TV traversal"
                    android:textColor="@color/cloneflix_grey_100"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </com.lagradost.cloudstream3.ui.revamp.components.CloneflixCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
