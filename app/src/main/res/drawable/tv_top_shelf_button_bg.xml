<?xml version="1.0" encoding="utf-8"?>
<!-- Selected while the top shelf is focused, as the whole shelf is the button -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="150"
    android:exitFadeDuration="150">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tvFocused" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tvTabSelected" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</selector>
