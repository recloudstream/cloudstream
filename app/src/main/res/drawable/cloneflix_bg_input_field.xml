<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cloneflix_grey_600" />
            <corners android:radius="@dimen/cloneflix_radius_xs" />
            <stroke
                android:width="2dp"
                android:color="@color/cloneflix_primary_white" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cloneflix_grey_600" />
            <corners android:radius="@dimen/cloneflix_radius_xs" />
            <stroke
                android:width="1dp"
                android:color="@color/cloneflix_grey_500" />
        </shape>
    </item>
</selector>
